{
	"description": "Cap violations: string length, repeater item count, and per-block serialized bytes.",
	"cases": [
		{
			"name": "token field over 160 chars",
			"type": "dinkus.section-header",
			"node": {
				"_type": "dinkus.section-header",
				"_key": "over-token",
				"number": "99999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999"
			},
			"expect": {
				"code": "max-length",
				"path": "number",
				"limit": 160,
				"actual": 161
			}
		},
		{
			"name": "short field over 320 chars",
			"type": "dinkus.cta-band",
			"node": {
				"_type": "dinkus.cta-band",
				"_key": "over-short",
				"heading": ""
			},
			"expect": {
				"code": "max-length",
				"path": "heading",
				"limit": 320,
				"actual": 321
			}
		},
		{
			"name": "long field over 8192 chars",
			"type": "dinkus.cta-band",
			"node": {
				"_type": "dinkus.cta-band",
				"_key": "over-long",
				"body": ""
			},
			"expect": {
				"code": "max-length",
				"path": "body",
				"limit": 8192,
				"actual": 8193
			}
		},
		{
			"name": "url field over 2048 chars",
			"type": "dinkus.cta-band",
			"node": {
				"_type": "dinkus.cta-band",
				"_key": "over-url",
				"ctaHref": "/proof?"
			},
			"expect": {
				"code": "max-length",
				"path": "ctaHref",
				"limit": 2048,
				"actual": 2059
			}
		},
		{
			"name": "repeater item long field over 2048 chars",
			"type": "dinkus.ledger-cards",
			"node": {
				"_type": "dinkus.ledger-cards",
				"_key": "over-item-long",
				"cards": [
					{
						"_key": "card-1",
						"body": ""
					}
				]
			},
			"expect": {
				"code": "max-length",
				"path": "cards[0].body",
				"limit": 2048,
				"actual": 2049
			}
		},
